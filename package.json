{
  "name": "sup-remission",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Superfluid points and claim investigation workbench",
  "scripts": {
    "export:point-events": "tsx tools/point-events/export-point-event-names.ts",
    "investigate:nonces": "node tools/sup-nonces/investigate-sup-nonces.js",
    "test:nonces": "vitest run tools/sup-nonces/investigate-sup-nonces.live.test.ts",
    "bundle:nonces": "esbuild tools/sup-nonces/investigate-sup-nonces.js --bundle --platform=browser --target=es2020 --outfile=investigate-sup-nonces.bundle.js",
    "build:skill": "node scripts/build-skill-zip.mjs",
    "recover:claim-sources": "node tools/claim-source-recovery/recover.mjs",
    "verify:claim-snapshot": "node tools/claim-source-recovery/verify-snapshot.mjs"
  },
  "dependencies": {
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "undici": "^7.24.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
